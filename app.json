{
  "expo": {
    "name": "Attendance Register",
    "slug": "attendance-register",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.attendanceregister.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-icon-monochrome.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to your photos to choose a registration picture.",
          "cameraPermission": "Allow camera access to take a registration picture."
        }
      ]
    ]
  }
}
